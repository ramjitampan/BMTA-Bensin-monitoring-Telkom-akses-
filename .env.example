# ───────────────────────────────────────────────
# APP
# ───────────────────────────────────────────────
APP_NAME="Telkom Akses Monitoring BBM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ───────────────────────────────────────────────
# LOGGING
# ───────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ───────────────────────────────────────────────
# DATABASE (MySQL)
# ───────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bensin_telkom
DB_USERNAME=root
DB_PASSWORD=

# ───────────────────────────────────────────────
# SESSION (database driver)
# ───────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ───────────────────────────────────────────────
# QUEUE / CACHE / FILESYSTEM
# ───────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ───────────────────────────────────────────────
# PERJALANAN — aplikasi
# ───────────────────────────────────────────────
PERJALANAN_MANAGER_NAME="Kepala Manager Operasional"
PERJALANAN_OFFICER_NAME="Petugas Administrasi"
PERJALANAN_TIF_PREFIX="TIF-2954"

# ───────────────────────────────────────────────
# VITE
# ───────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
